DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_NAME=<DB_NAME>

FLASK_DEBUG=1

# 任意 OpenAI 兼容端点，切换 provider 只需改以下三项
# MiniMax:  https://api.minimax.chat/v1
# model:MiniMax-M3
# DeepSeek: https://api.deepseek.com/v1
# 阿里百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen:https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# model:qwen3.8-max、qwen3.7-max、qwen3.7-plus、qwen3.6-flash、qwen-audio-3.0-tts-plus、qwen-audio-3.0-realtime-plus、deepseek-v4-pro、glm-5.2
# Moonshot: https://api.moonshot.cn/v1
# OpenAI:   https://api.openai.com/v1
# Ollama:   http://localhost:11434/v1
LLM_API_BASE=https://api.minimax.chat/v1
LLM_API_KEY=your-LLM_API_KEY
LLM_MODEL=MiniMax-M3
